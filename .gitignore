# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
env/

# PyInstaller
build/
dist/
*.spec.bak

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/

# App runtime
*.log

# Local test data (do not commit microscope data)
sample_data/*.ktf
scratchpad/
synthetic/
work/

# Local agent and handoff notes. Their real files live outside the Git root in
# ../Non-Sharable; these entries also protect the local convenience symlinks.
/AGENTS.md
/CLAUDE.md
/HANDOFF.md
/Non-Sharable/
/review_*/

# Exported results — the app's save dialogs default to the working directory, so
# real experiment output easily lands here. Never publish it.
*.ktf
*.gci
*.ici
*.ibc2
*.chf
*.raw
*.tif
*.tiff
*.pdf
*.png
*.jpg
*.mosaic-qc.json
*_alignment.csv
*_stitch_qc.csv
*_conditions.csv
!docs/**/*.png
